:global(.react-datepicker) {
  --day-size: 30px;
  --day-font-size: var(--font-size12);
  --day-name-size: 30px;
  --day-name-font-size: var(--font-size10);
  --header-padding: 9px 11px;
  --month-year-font-size: var(--font-size13);
  --day-names-padding: 5px 0;
  --month-padding: 0 5px 5px;
  --input-padding: 5px 7px;
  --input-font-size: var(--font-size13);
  --container-padding: 5px;
  --navigation-size: 18px;
  --navigation-top: 11px;
  --navigation-offset: 7px;
  --navigation-icon-size: 6px;
}

.label {
  font-weight: var(--font-weight-medium);
  font-size: var(--font-size18);
  color: var(--black-color);
  margin-bottom: 8px;
}

.container {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.dateInput {
  width: 100%;
  padding: 15px 20px;
  margin-bottom: 2px;
  font-family: inherit;
  border: 1px solid var(--grey-3-color);
  border-radius: var(--small-radius);
  font-weight: var(--font-weight-medium);
  font-size: var(--font-size15);
  line-height: 24px;
  transition: outline-width 0.1s ease;
  color: var(--grey-1-color);
  box-sizing: border-box;

  &:hover,
  &:focus {
    outline: 3px solid var(--green-1-color);
  }

  &::placeholder {
    font-weight: var(--font-weight-regular);
    color: var(--grey-2-color);
  }
}

.inputError {
  outline: 3px solid var(--red-1-color);

  &:focus,
  &:hover {
    outline: 3px solid var(--red-1-color);
  }
}

.errorBlock {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 30px;
}

.errorText {
  font-size: var(--font-size14);
  font-weight: var(--font-weight-semi-bold);
  font-family: inherit;
  color: var(--red-1-color);
}


:global(.react-datepicker) {
  border: none;
  border-radius: var(--normal-radius);
  box-shadow: var(--shadow-2);
  background-color: var(--white-color);
  font-family: 'Inter', sans-serif;
  padding: var(--container-padding);
  animation: fadeIn 0.3s ease-out;
  z-index: 3;
}

@keyframes fadeInOverlay {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

:global(.react-datepicker__header) {
  font-family: 'Inter', sans-serif;
  background-color: var(--green-3-color);
  border-bottom: none;
  padding: var(--header-padding);
  text-align: center;
}

:global(.react-datepicker__current-month) {
  font-family: 'Inter', sans-serif;
  font-size: var(--month-year-font-size);
  font-weight: var(--font-weight-semi-bold);
  color: var(--black-color);
}

:global(.react-datepicker__day-names) {
  font-family: 'Inter', sans-serif;
  display: flex;
  padding: var(--day-names-padding);
}

:global(.react-datepicker__day-name) {
  width: var(--day-name-size);
  line-height: var(--day-name-size);
  text-align: center;
  font-size: var(--day-name-font-size);
  font-weight: var(--font-weight-medium);
  color: var(--grey-1-color);
  text-transform: uppercase;
}

:global(.react-datepicker__month) {
  padding: var(--month-padding);
}

:global(.react-datepicker__day) {
  font-family: 'Inter', sans-serif;
  width: var(--day-size);
  height: var(--day-size);
  line-height: var(--day-size);
  text-align: center;
  font-size: var(--day-font-size);
  color: var(--black-color);
  border-radius: 50%;
  transition: background-color 0.3s ease, color 0.3s ease !important;
  cursor: pointer !important;
}

:global(.react-datepicker__day:hover) {
  background-color: var(--green-3-color) !important;
  color: var(--green-2-color) !important;
}

:global(.react-datepicker__day--selected),
:global(.react-datepicker__day--keyboard-selected) {
  background-color: var(--green-2-color) !important;
  color: var(--white-color) !important;
  font-weight: var(--font-weight-semi-bold) !important;
}

:global(.react-datepicker__day--outside-month) {
  color: var(--grey-2-color) !important;
}

:global(.react-datepicker__day--disabled) {
  color: var(--grey-2-color) !important;
  cursor: not-allowed !important;
  background-color: transparent !important;
}

:global(.react-datepicker__day--disabled:hover) {
  background-color: transparent !important;
  color: var(--grey-2-color) !important;
}

:global(.react-datepicker__navigation) {
  top: var(--navigation-top) !important;
  width: var(--navigation-size) !important;
  height: var(--navigation-size) !important;
  border: none !important;
  cursor: pointer !important;
}

:global(.react-datepicker__navigation--previous) {
  left: var(--navigation-offset) !important;
}

:global(.react-datepicker__navigation--next) {
  right: var(--navigation-offset) !important;
}

:global(.react-datepicker__navigation-icon::before) {
  border-color: var(--grey-1-color) !important;
  border-width: 2px 2px 0 0 !important;
  width: var(--navigation-icon-size) !important;
  height: var(--navigation-icon-size) !important;
}

:global(.react-datepicker__triangle) {
  display: none !important;
}

@media (--breakpoint-tablet) {
  :global(.react-datepicker) {
    --day-size: 40px;
    --day-font-size: var(--font-size14);
    --day-name-size: 40px;
    --day-name-font-size: var(--font-size12);
    --header-padding: 12px 16px;
    --month-year-font-size: var(--font-size16);
    --day-names-padding: 8px 0;
    --month-padding: 0 8px 8px;
    --input-padding: 6px 8px;
    --input-font-size: var(--font-size14);
    --container-padding: 8px;
    --navigation-size: 24px;
    --navigation-top: 14px;
    --navigation-offset: 12px;
    --navigation-icon-size: 8px;
  }
}