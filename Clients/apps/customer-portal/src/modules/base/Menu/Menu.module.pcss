.menuBox {
  width: 100%;
  height: 66px;
  background-color: var(--white-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.account {
  display: none;
}

@media (--breakpoint-laptop) {
  .account {
    display: flex;
  }

  .menuBox {
    width: 100%;
    max-width: 1300px;
    padding-left: 20px;
    padding-right: 20px;
    margin-top: 40px;
    margin-left: auto;
    margin-right: auto;
    background-color: transparent;
  }
}

@media (--breakpoint-desktop) {
  .menuBox {
    padding: 0;
  }
}