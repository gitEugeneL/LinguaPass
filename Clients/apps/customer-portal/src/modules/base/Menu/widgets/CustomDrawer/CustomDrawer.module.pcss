.drawer {
  min-width: 250px;
  max-width: 450px;
  position: relative;
}

.closeButton {
  margin-top: 20px;
  margin-right: 20px;
  cursor: pointer;
  padding: 15px;
  width: fit-content;
  margin-left: auto;
  border-radius: var(--normal-radius);
  transition: background-color 0.3s ease;

  & svg {
    transition: transform 0.3s ease;
  }

  &:focus,
  &:hover {
    background-color: var(--white-color);
    box-shadow: var(--shadow-1);

    & svg {
      transform: rotate(90deg);
    }
  }

  &:hover svg path,
  &:focus svg path {
    stroke: var(--green-2-color);
    transition: fill 0.3s ease;
  }
}

.btn {
  width: 30%;
}

.context {
  display: flex;
  flex-direction: column;
  align-items: center;
}

@media (--breakpoint-laptop) {
  .container {
    display: none;
  }
}