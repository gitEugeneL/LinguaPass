.container {
  margin-bottom: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 50px;
}

.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 250px;
  height: 250px;
  background-color: var(--white-color);
  border-radius: 100%;
}

.title {
  font-size: var(--font-size26);
  font-weight: var(--font-weight-semi-bold);
  line-height: 1.4;
  text-align: center;
  color: var(--green-1-color);
  max-width: 700px;
}

.errorTitle {
  font-size: var(--font-size26);
  font-weight: var(--font-weight-semi-bold);
  line-height: 1.4;
  text-align: center;
  color: var(--black-color);
  max-width: 700px;
}

.errorBlock {
  padding: 50px;
  width: 60%;
  background-color: var(--white-color);
  border-radius: var(--normal-radius);
}

.errorSubTitle {
  font-weight: var(--font-weight-semi-bold);
  color: var(--black-color);
  font-size: var(--font-size20);
  margin-bottom: 20px;
}

.btn {
  margin-top: 20px;
  display: flex;
  justify-content: flex-end;
}

.description {
  text-align: center;
  max-width: 550px;
  line-height: 1.6;
  font-size: var(--font-size16);
  font-weight: var(--font-weight-regular);
  color: var(--grey-1-color);
}

.wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

@media (--breakpoint-tablet) {
  .icon {
    width: 300px;
    height: 300px;
  }
}
