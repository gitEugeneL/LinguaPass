.container {
  position: relative;

  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10px;
  margin: 60px auto 60px;
  width: 95%;
}

@media (--breakpoint-tablet) {
  .container {
    gap: 20px;
    margin-top: 100px;
    margin-bottom: 80px;
    max-width: 850px;
  }
}

@media (--breakpoint-laptop) {
  .container {
    margin-top: 100px;
    margin-bottom: 80px;
  }
}