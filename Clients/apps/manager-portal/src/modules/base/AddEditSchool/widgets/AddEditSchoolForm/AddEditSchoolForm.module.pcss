.wrapper {
  max-width: 100%;
  margin-top: -40px;
  display: flex;
  flex-direction: column;
}

.notification {
  position: relative;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30px;
  margin-top: 40px;
  transition: margin-top 0.3s ease;
}

.error {
  margin-top: 100px;
}

.card {
  min-width: 400px;
  max-width: 500px;
  width: 100%;
  padding: 40px;
  background-color: var(--white-color);
  border-radius: var(--normal-radius);
}

@media (min-width: 1200px) {
  .container {
    flex-direction: row;
    align-items: flex-start;
    gap: 50px;
  }
}