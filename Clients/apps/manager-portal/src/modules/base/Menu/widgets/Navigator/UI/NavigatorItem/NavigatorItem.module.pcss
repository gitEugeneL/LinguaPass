.item {
  padding-left: 20px;
  padding-top: 12px;
  padding-bottom: 12px;
  display: block;
  width: 100%;
  color: var(--grey-1-color);
  font-size: var(--font-size16);
  font-weight: var(--font-weight-medium);
  transition: box-shadow 0.3s ease, color 0.3s ease;
  cursor: pointer;

  &:hover,
  &:focus:not(.active) {
    color: var(--green-1-color);
  }
}

.active {
  color: var(--green-2-color);
}