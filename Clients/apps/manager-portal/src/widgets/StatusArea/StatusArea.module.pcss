.wrapper {
  position: fixed;
  top: 0;
  left: 272px;
  right: 0;
  background-color: var(--background-color);
  padding-top: 30px;
  padding-left: 30px;
  padding-right: 30px;
}

.container {
  width: 100%;
  max-width: 100%;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 30px;
  background-color: var(--white-color);
  border-radius: var(--normal-radius);
  box-shadow: var(--shadow-1);
  flex-shrink: 1;
  min-width: 0;
}

.nameWrapper {
  display: flex;
  gap: 20px;
  flex-shrink: 1;
  min-width: 0;
}

.name {
  margin-top: 8px;
  font-size: var(--font-size26);
  font-weight: var(--font-weight-medium);
  color: var(--black-color);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.content {
  display: flex;
  gap: 40px;
  flex-shrink: 0;
}