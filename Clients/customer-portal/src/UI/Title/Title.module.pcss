.wrapper {
  display: flex;
  flex-direction: column;
}

.title {
  width: max-content;
  margin: 0 0 5px;
  font-size: var(--font-size32);
  line-height: 45px;
  font-weight: var(--font-weight-regular);
  color: var(--black-color);
}

.description {
  margin: 0;
  font-size: var(--font-size15);
  line-height: 24px;
  font-weight: var(--font-weight-regular);
  color: var(--grey-1-color);
}