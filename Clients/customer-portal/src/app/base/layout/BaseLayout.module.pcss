.container {
  display: flex;
  justify-content: center;
  flex-direction: column;
  min-height: 100vh;
  min-width: 380px;
  background-color: var(--background-color);
}

.body {
  padding-right: 20px;
  padding-left: 20px;
  flex-grow: 1;
}

.footer {
  margin-top: auto;
}

@media (--breakpoint-tablet) {
  .body {
    padding-right: 40px;
    padding-left: 40px;
  }
}

@media (--breakpoint-desktop) {
  .body {
    padding-right: 70px;
    padding-left: 70px;
  }
}
