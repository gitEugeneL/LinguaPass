.card {
  display: flex;
  flex-direction: column;
  border-radius: var(--normal-radius);
  width: fit-content;

  &:nth-child(8n + 1) > div:first-child {
    background-color: #F7F2C2;
  }

  &:nth-child(8n + 2) > div:first-child {
    background-color: #E4DDD6;
  }

  &:nth-child(8n + 3) > div:first-child {
    background-color: #F1E0EB;
  }

  &:nth-child(8n + 4) > div:first-child {
    background-color: #C0D2E0;
  }

  &:nth-child(8n + 5) > div:first-child {
    background-color: #B6D0FE;
  }

  &:nth-child(8n + 6) > div:first-child {
    background-color: #F7D8D5;
  }

  &:nth-child(8n + 7) > div:first-child {
    background-color: #C7DAD0;
  }

  &:nth-child(8n + 8) > div:first-child {
    background-color: #E7DFF7;
  }
}

.info {
  order: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  padding: 30px;
  border-bottom-left-radius: var(--normal-radius);
  border-bottom-right-radius: var(--normal-radius);

  max-width: 450px;
}

.infoWrapper {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  display: flex;
  justify-content: space-between;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 15px;

  > div:nth-child(1),
  > div:nth-child(2) {
    margin-left: auto;
    align-items: center;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  @media (min-width: 438px) {
    > div:nth-child(1),
    > div:nth-child(2) {
      align-items: flex-start;
    }
  }
}

.btn {
  margin-top: 30px;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  max-width: 250px;
}

.infoText {
  color: var(--black-color);
  font-weight: var(--font-weight-bold);
  font-size: var(--font-size15);
}

.infoContent {
  margin-left: 5px;
  font-weight: var(--font-weight-regular);
}

.main {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 25px;
  width: 100%;
  padding: 30px 40px;
  background-color: var(--white-color);
  border-top-right-radius: var(--normal-radius);
  border-top-left-radius: var(--normal-radius);

  max-width: 450px;
}

.mainWrapper {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.name {
  text-align: center;
  color: var(--black-color);
  font-weight: var(--font-weight-bold);
  font-size: var(--font-size22);
}

.school {
  text-align: center;
  color: var(--grey-1-color);
  font-size: var(--font-size14);
  font-weight: var(--font-weight-medium);
}

.type {
  padding: 4px 18px;
  width: fit-content;
  font-weight: var(--font-weight-regular);
  font-size: var(--font-size12);
  color: var(--white-color);
  background-color: var(--grey-2-color);
}

.description {
  text-align: center;
  color: var(--grey-1-color);
  font-size: var(--font-size14);
  font-weight: var(--font-weight-regular);
  line-height: 22px;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  text-overflow: ellipsis;
}

.activities {
  text-align: center;
  color: var(--black-color);
  font-size: var(--font-size12);
  font-weight: var(--font-weight-medium);
  line-height: 22px;
}

.activitiesTitle {
  margin-right: 5px;
  font-weight: var(--font-weight-bold);
}

@media (--breakpoint-tablet) {
  .card {
    flex-direction: row;
    min-height: 300px;
  }

  .info {
    order: 0;
    align-items: flex-start;
    width: 350px;
    padding: 40px;
    border-bottom-right-radius: 0;
    border-top-left-radius: var(--normal-radius);
  }

  .infoWrapper {

    > div:nth-child(1),
    > div:nth-child(2) {
      width: 100%;
    }
  }

  .name {
    font-size: var(--font-size28);
  }

  .school {
    font-size: var(--font-size16);
  }

  .name,
  .school {
    text-align: left;
  }

  .description {
    text-align: left;
    font-size: var(--font-size16);
    line-height: 24px;
  }

  .type {
    padding: 5px 25px;
    font-size: var(--font-size14);
  }

  .activities {
    text-align: left;
    font-size: var(--font-size14);
    line-height: 24px;
  }

  .infoText {
    font-size: var(--font-size16);
  }

  .infoWrapper {
    gap: 15px;
  }

  .mainWrapper {
    align-items: flex-start;
  }

  .main {
    padding-bottom: 40px;
    max-width: 100%;
    border-top-left-radius: 0;
    border-bottom-right-radius: var(--normal-radius);
  }
}

@media (--breakpoint-laptop) {

  .description {
    -webkit-line-clamp: none;
  }
}