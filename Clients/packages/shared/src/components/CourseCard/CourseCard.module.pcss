.card {
  display: flex;
  flex-direction: column;
  border-radius: var(--normal-radius);
  width: 450px;
  cursor: pointer;

  &:nth-child(8n + 1) > div:first-child {
    background-color: #f7f2c2;
  }

  &:nth-child(8n + 2) > div:first-child {
    background-color: #e4ddd6;
  }

  &:nth-child(8n + 3) > div:first-child {
    background-color: #f1e0eb;
  }

  &:nth-child(8n + 4) > div:first-child {
    background-color: #c0d2e0;
  }

  &:nth-child(8n + 5) > div:first-child {
    background-color: #b6d0fe;
  }

  &:nth-child(8n + 6) > div:first-child {
    background-color: #f7d8d5;
  }

  &:nth-child(8n + 7) > div:first-child {
    background-color: #c7dad0;
  }

  &:nth-child(8n + 8) > div:first-child {
    background-color: #e7dff7;
  }

  &:focus,
  &:hover {
    box-shadow: var(--shadow-1);
  }
}

.info {
  order: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  padding: 30px;
  border-bottom-left-radius: var(--normal-radius);
  border-bottom-right-radius: var(--normal-radius);

  max-width: 450px;
}

.infoWrapper {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  display: flex;
  justify-content: space-between;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 15px;

  > div:nth-child(1),
  > div:nth-child(2) {
    margin-left: auto;
    align-items: center;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  @media (min-width: 412px) {
    > div:nth-child(1),
    > div:nth-child(2) {
      align-items: flex-start;
    }
  }
}

.btn {
  margin-top: 30px;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  max-width: 250px;
}

.infoText {
  color: var(--black-color);
  font-weight: var(--font-weight-bold);
  font-size: var(--font-size15);
}

.infoContent {
  margin-left: 5px;
  font-weight: var(--font-weight-regular);
}

.main {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 25px;
  padding: 30px 40px;
  background-color: var(--white-color);
  border-top-right-radius: var(--normal-radius);
  border-top-left-radius: var(--normal-radius);
  width: 100%;
}

.mainWrapper {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.name {
  text-align: center;
  color: var(--black-color);
  font-weight: var(--font-weight-bold);
  font-size: var(--font-size22);
}

.school {
  text-align: center;
  color: var(--grey-1-color);
  font-size: var(--font-size14);
  font-weight: var(--font-weight-medium);
}

.type {
  padding: 4px 18px;
  width: fit-content;
  font-weight: var(--font-weight-regular);
  font-size: var(--font-size12);
  color: var(--white-color);
  background-color: var(--grey-2-color);
}

.description {
  text-align: center;
  color: var(--grey-1-color);
  font-size: var(--font-size14);
  font-weight: var(--font-weight-regular);
  line-height: 22px;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  text-overflow: ellipsis;
}

.activities {
  text-align: center;
  color: var(--black-color);
  font-size: var(--font-size12);
  font-weight: var(--font-weight-medium);
  line-height: 22px;
}

.activitiesTitle {
  margin-right: 5px;
  font-weight: var(--font-weight-bold);
}

.notChosenCard {
  opacity: 0.5;
  filter: grayscale(100%);

  &:hover,
  &:focus-visible {
    opacity: 1;
    transition: opacity 0.3s ease-in-out;
    filter: grayscale(0%);
  }
}

.chosenCard {
  box-shadow: var(--shadow-1);

  .info {
    background-color: var(--white-color) !important;
    border-top: 1px solid var(--grey-3-color);
    transition: border-color 0.3s ease;
  }

  &:focus,
  &:hover {
    .info {
      border-color: transparent;
    }
  }
}

.activeCard {
  opacity: 1;
  filter: grayscale(0%);
  box-shadow: var(--shadow-1);
}

.loading {
  background: linear-gradient(to right, var(--loading-color) 50%, var(--white-color) 50%);
  background-size: 200% 100%;
  background-position: 100% 0;
  animation: fillFromLeft 1.5s ease forwards;
}

@keyframes fillFromLeft {
  to {
    background-position: 0 0;
  }
}

@media (--breakpoint-tablet) {
  .chosenCard {
    .info {
      border-top: none;
      border-right: 1px solid var(--grey-3-color);
    }
  }

  .card {
    width: 100%;
    flex-direction: row;
    min-height: 300px;
  }

  .info {
    order: 0;
    align-items: flex-start;
    width: 350px;
    padding: 40px;
    border-bottom-right-radius: 0;
    border-top-left-radius: var(--normal-radius);
  }

  .infoWrapper {
    > div:nth-child(1),
    > div:nth-child(2) {
      width: 100%;
    }
  }

  .name {
    font-size: var(--font-size28);
  }

  .school {
    font-size: var(--font-size16);
  }

  .name,
  .school {
    text-align: left;
  }

  .description {
    text-align: left;
    font-size: var(--font-size16);
    line-height: 24px;
  }

  .type {
    padding: 5px 25px;
    font-size: var(--font-size14);
  }

  .activities {
    text-align: left;
    font-size: var(--font-size14);
    line-height: 24px;
  }

  .infoText {
    font-size: var(--font-size16);
  }

  .infoWrapper {
    gap: 15px;
  }

  .mainWrapper {
    align-items: flex-start;
  }

  .main {
    padding-bottom: 40px;
    max-width: 100%;
    border-top-left-radius: 0;
    border-bottom-right-radius: var(--normal-radius);
  }
}

@media (--breakpoint-laptop) {
  .description {
    -webkit-line-clamp: none;
  }
}
