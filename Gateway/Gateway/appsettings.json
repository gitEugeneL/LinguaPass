          }
        }
      },
      "account-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7007/api"
          }
        }
      },
      "progress-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7295/api"
          }
        }
      },
      "storage-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7044/api"
          }
        }
      }
    }
  }
}