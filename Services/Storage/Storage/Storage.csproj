<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- Include shared projects -->
    <ItemGroup>
        <ProjectReference Include="..\..\Common\AuthConfig\AuthConfig.csproj"/>
        <ProjectReference Include="..\..\Shared\Shared.csproj"/>
    </ItemGroup>

    <!-- Include shared settings -->
    <ItemGroup>
        <Content Include="..\..\Common\AuthConfig\authsettings.json"
                 Link="authsettings.json"
                 CopyToOutputDirectory="Always"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints" Version="6.0.0"/>
        <PackageReference Include="itext7" Version="9.1.0"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4"/>
        <PackageReference Include="Minio" Version="6.0.4"/>
    </ItemGroup>

</Project>
