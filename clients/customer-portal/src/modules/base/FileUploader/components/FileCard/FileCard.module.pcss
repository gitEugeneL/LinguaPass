.card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-direction: column;
  gap: 20px;
  width: 100%;
  min-height: 68px;
  padding: 20px;
  background-color: var(--white-color);
  border-radius: var(--normal-radius);
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.3s ease-out forwards;
  transition: box-shadow 0.3s;
}

@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(-20px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.disabledCard {
  opacity: 0.5 !important;
  cursor: not-allowed;
  pointer-events: none;
}

.activeCard {
  box-shadow: var(--shadow-1);
}

.progressBlock {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--green-1-color);
  font-size: var(--font-size14);
}

.progress {
  width: 30px;
  display: block;
}

.btnBlock {
  width: 100%;
  min-width: 180px;
  display: flex;
  align-items: center;
  gap: 20px;
}

.exit {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
  border-radius: var(--normal-radius);

  & svg {
    transition: transform 0.3s ease;
  }

  &:focus,
  &:hover {
    background-color: var(--white-color);
    box-shadow: var(--shadow-1);

    & svg {
      transform: rotate(90deg);
    }
  }

  &:active {
    box-shadow: none;
  }

  &:hover svg path,
  &:focus svg path {
    stroke: var(--green-2-color);
    transition: fill 0.3s ease;
  }
}

.titleBlock {
  max-width: 85%;
  margin-right: auto;
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  display: flex;
  gap: 8px;
  flex-direction: column;
  box-sizing: border-box;
}

.name {
  display: block;
  min-width: 0;
  font-size: var(--font-size14);
  font-weight: var(--font-weight-medium);
  color: var(--black-color);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}


@media (min-width: 500px) {
  .card {
    flex-direction: row;
  }

  .titleBlock {
    margin-left: 13px;
  }

  .exit {
    position: revert;
    min-width: 50px;
  }

  .btnBlock {
    min-width: 180px;
    max-width: 180px;
  }
}

@media (--breakpoint-tablet) {
  .card {
    gap: 10px;
  }

  .activeBtnBlock {
    max-width: 350px;
  }
}

@media (--breakpoint-laptop) {
  .activeBtnBlock {
    max-width: 400px;
  }
}
